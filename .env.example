# ─────────────────────────────────────────
# ZapIA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# ─────────────────────────────────────────

# ═══════════════════════════════════════
# DOMÍNIO & URLS
# ═══════════════════════════════════════
DOMAIN=seudominio.com.br
APP_URL=https://seudominio.com.br
BACKEND_URL=https://api.seudominio.com.br
SSL_EMAIL=seu@email.com

# ═══════════════════════════════════════
# BANCO DE DADOS (PostgreSQL)
# ═══════════════════════════════════════
POSTGRES_USER=zapia
POSTGRES_PASSWORD=TROQUE_PARA_UMA_SENHA_FORTE
POSTGRES_DB=zapia_db

# ═══════════════════════════════════════
# REDIS
# ═══════════════════════════════════════
REDIS_PASSWORD=TROQUE_PARA_UMA_SENHA_FORTE

# ═══════════════════════════════════════
# EVOLUTION API (Gateway WhatsApp)
# ═══════════════════════════════════════
EVOLUTION_API_KEY=TROQUE_PARA_UMA_CHAVE_FORTE
EVOLUTION_SERVER_URL=https://wa.seudominio.com.br

# ═══════════════════════════════════════
# OPENROUTER (LLM Gateway)
# ═══════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-SUACHAVE

# Modelos disponíveis via OpenRouter:
# openai/gpt-4o-mini (recomendado - custo/benefício)
# openai/gpt-4o
# anthropic/claude-3.5-sonnet
# google/gemini-pro-1.5
# meta-llama/llama-3.1-70b-instruct (gratuito)

# ═══════════════════════════════════════
# AUTENTICAÇÃO
# ═══════════════════════════════════════
JWT_SECRET=GERE_COM: openssl rand -base64 64
